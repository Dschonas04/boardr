# Kopieren nach .env und ausfüllen. .env gehört nicht ins Repository.
DB_KENNWORT=
# Geheimnisse für Widgets. NAME trägt man beim Widget ein, _ZIEL ist der einzige
# Host, an den das Geheimnis geht:
# BOARDR_WIDGET_NAME=
# BOARDR_WIDGET_NAME_ZIEL=https://host:port
# Notausgang, falls man sich ausgesperrt hat: Anmeldung ganz aus.
# BOARDR_SSO_AUS=1
# Wer verwaltet, zusätzlich zum ersten Konto aus der Einrichtung. Bei SSO nötig:
# BOARDR_ADMIN=oidc:https://anbieter.example/realms/name|<sub>
